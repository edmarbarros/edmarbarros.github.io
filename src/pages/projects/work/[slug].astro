---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Prose from '../../../components/Prose.astro';
import Tag from '../../../components/Tag.astro';
import { render } from 'astro:content';
import { getProjects, projectSlug } from '../../../content/helpers';

export async function getStaticPaths() {
  const entries = await getProjects('en', 'work');
  return entries.map((entry) => ({
    params: { slug: projectSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, company, role, period, location, summary, stack, link } = entry.data;
---

<BaseLayout title={title} lang="en" description={summary}>
  <article class="space-y-8">
    <header class="space-y-3">
      <p class="text-sm">
        <a href="/projects" class="text-muted hover:text-accent">← Projects</a>
      </p>
      <h1 class="font-serif text-4xl md:text-5xl">{title}</h1>
      <p class="text-muted flex flex-wrap gap-x-3 gap-y-1 text-sm">
        <span>{period}</span>
        {location && <span>· {location}</span>}
        {link && <>
          {'· '}<a href={link} rel="noopener" class="no-underline hover:text-accent">{new URL(link).hostname} ↗</a>
        </>}
      </p>
      <ul class="flex flex-wrap gap-2 pt-2">
        {stack.map((s: string) => <li><Tag label={s} /></li>)}
      </ul>
    </header>
    <Prose>
      <Content />
    </Prose>
    <p class="pt-8 border-t border-border">
      <a href="/projects" class="text-sm text-muted hover:text-accent">← Back to Projects</a>
    </p>
  </article>
</BaseLayout>
