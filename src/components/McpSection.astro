---
import { SITE_CONFIG } from '../config';
import { getUIStrings, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getUIStrings(lang).mcp;

const url = SITE_CONFIG.mcpEndpoint;
const name = 'edmarbarros';
// The post about how this server was built, one per language.
const postHref = lang === 'pt' ? '/pt/blog/site-como-mcp' : '/blog/site-as-mcp';

const cursorConfig = JSON.stringify({ mcpServers: { [name]: { url } } }, null, 2);
const vscodeConfig = JSON.stringify({ servers: { [name]: { type: 'http', url } } }, null, 2);

// Product names and commands are not translated; only the surrounding text is.
const clients: { name: string; text?: string; code?: string }[] = [
  { name: 'Claude Code', text: t.terminal, code: `claude mcp add --transport http ${name} ${url}` },
  { name: 'Claude (web and desktop)', text: t.claudeApp },
  { name: 'ChatGPT', text: t.chatgpt },
  { name: 'Cursor', text: t.cursor, code: cursorConfig },
  { name: 'VS Code', text: t.vscode, code: vscodeConfig },
  { name: 'Gemini CLI', text: t.terminal, code: `gemini mcp add --transport http ${name} ${url}` },
  { name: 'Codex CLI', text: t.terminal, code: `codex mcp add ${name} --url ${url}` },
];
---

<section class="max-w-prose border-t border-border pt-8 mt-12" aria-labelledby="mcp-title">
  <details id="mcp" class="group">
    <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
      <h2 id="mcp-title" class="font-serif text-2xl flex items-center gap-2">
        <svg
          class="w-5 h-5 shrink-0 text-muted transition-transform group-open:rotate-90"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 6l6 6-6 6"></path>
        </svg>
        {t.title}
      </h2>
      <p class="leading-relaxed mt-2">{t.intro}</p>
    </summary>

    <div class="mt-5 space-y-5">
      <div>
        <p class="text-sm text-muted mb-1">{t.endpoint}</p>
        <div class="flex flex-wrap items-center gap-3">
          <code class="font-mono text-sm border border-border rounded px-3 py-2 break-all select-all" id="mcp-url">{url}</code>
          <button
            type="button"
            id="mcp-copy"
            hidden
            data-copy={t.copy}
            data-copied={t.copied}
            class="text-sm border border-border rounded px-3 py-2 hover:text-accent hover:border-accent cursor-pointer"
          >{t.copy}</button>
        </div>
      </div>

      <div>
        <p class="text-sm text-muted mb-1">{t.tryTitle}</p>
        <ul class="list-disc pl-5 space-y-1">
          {t.prompts.map((p: string) => <li>{p}</li>)}
        </ul>
      </div>

      <div>
        <h3 class="font-serif text-lg mb-2">{t.setupTitle}</h3>
        <div class="border-t border-border">
          {clients.map((c) => (
            <details class="border-b border-border py-2">
              <summary class="cursor-pointer font-medium">{c.name}</summary>
              <div class="mt-2 space-y-2 text-sm">
                {c.text && <p>{c.text}</p>}
                {c.code && (
                  <pre class="font-mono text-xs border border-border rounded p-3 overflow-x-auto"><code>{c.code}</code></pre>
                )}
              </div>
            </details>
          ))}
        </div>
        <p class="text-sm text-muted mt-3">{t.other}</p>
      </div>

      <p class="text-sm"><a href={postHref}>{t.readMore} →</a></p>
    </div>
  </details>
</section>

<script>
  // Link to /#mcp opens the section.
  const section = document.getElementById('mcp');
  if (section && location.hash === '#mcp') section.setAttribute('open', '');

  const button = document.getElementById('mcp-copy');
  const target = document.getElementById('mcp-url');
  if (button && target) {
    // The URL stays selectable without JavaScript; the button only appears when copying can work.
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(target.textContent ?? '');
        button.textContent = button.dataset.copied ?? 'Copied';
        setTimeout(() => {
          button.textContent = button.dataset.copy ?? 'Copy';
        }, 2000);
      } catch {
        // Clipboard blocked: the URL is already selectable.
      }
    });
  }
</script>
